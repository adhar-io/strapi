# syntax=docker/dockerfile:1.7
#
# ghcr.io/adhar-io/strapi — a ready-to-run Strapi server for the Adhar platform.
#
# Upstream retired `strapi/strapi` and publishes no server image, so the
# platform used to scaffold a project, npm-install ~700 MiB and build the admin
# panel inside the pod on first boot (four to six minutes, and the source of
# the hollow-@swc and sticky-/tmp failures). This image does all of that at
# build time, once, and swaps in the fork's @strapi/core (admin SSO; see
# packages/core/core/src/ee/index.ts) before the admin panel is built.
#
# Build context: this directory, plus the fork's packed core at
# ./strapi-core.tgz (the release workflow puts it there; see adhar/README.md).
#
# What stays on the volume (/srv/app, the layout the platform already used, so
# an existing PVC carries over): src/api, src/components, src/extensions — what
# the Content-Type Builder writes — and public/uploads. Everything else is the
# image.

ARG NODE_IMAGE=node:22-bookworm-slim

# node:*-alpine is deliberately avoided: Strapi pulls native modules and the
# musl build of @swc/core dies with SIGBUS during its postinstall.
FROM ${NODE_IMAGE} AS build

ARG STRAPI_VERSION
RUN test -n "${STRAPI_VERSION}" || { echo "STRAPI_VERSION build-arg is required"; exit 1; }

ENV CI=true \
    npm_config_yes=true \
    npm_config_fund=false \
    npm_config_audit=false \
    npm_config_update_notifier=false \
    STRAPI_TELEMETRY_DISABLED=true

# Built at /opt/app, the path it runs from, so the absolute file: spec below
# stays valid in the runtime image's lockfile.
WORKDIR /opt

# Scaffold with upstream's own tooling at exactly the version the core tarball
# was packed from — Strapi's packages move in lockstep. --dbclient postgres is
# what makes create-strapi install the `pg` driver; the connection values are
# placeholders, the generated config/database.js reads DATABASE_* at runtime.
RUN npx -y "create-strapi@${STRAPI_VERSION}" app \
      --no-run --skip-cloud --use-npm --javascript \
      --no-example --no-git-init --install \
      --dbclient postgres \
      --dbhost localhost --dbport 5432 --dbname strapi \
      --dbusername strapi --dbpassword build-placeholder

WORKDIR /opt/app

# The fork's @strapi/core, via an npm override: GitHub Packages cannot host
# @strapi/* under adhar-io, and renaming the package breaks every internal
# import. Absolute, because npm resolves a relative file: in `overrides`
# against each dependent package rather than the project. Kept in vendor/ (and
# shipped) so the lockfile's spec resolves.
COPY strapi-core.tgz vendor/strapi-core.tgz
RUN npm pkg set 'overrides.@strapi/core=file:/opt/app/vendor/strapi-core.tgz' \
 && npm install --include=optional \
 && npm install --save-exact passport-oauth2@1

# One version of every lockstep @strapi/* package. Plugins peer-depend on
# @strapi/admin `^5.0.0`, so npm otherwise hoists the newest 5.x beside the
# pinned copies and the server runs a mix (see build/pin-lockstep.js). Pin,
# reinstall from scratch, repeat until nothing drifts; fail if it never settles.
COPY build/pin-lockstep.js /opt/build/pin-lockstep.js
RUN set -eu; \
    for attempt in 1 2 3; do \
      node /opt/build/pin-lockstep.js "${STRAPI_VERSION}" check && exit 0; \
      node /opt/build/pin-lockstep.js "${STRAPI_VERSION}" pin; \
      rm -rf node_modules package-lock.json; \
      npm install --include=optional; \
    done; \
    node /opt/build/pin-lockstep.js "${STRAPI_VERSION}" check

# Refuse to ship an image that silently has no SSO: exactly one @strapi/core,
# at the scaffolded version, carrying the fork's marker.
RUN set -eu; \
    cores="$(find node_modules -path '*/@strapi/core/package.json' -not -path '*/vendor/*')"; \
    echo "$cores"; \
    [ "$(echo "$cores" | wc -l)" -eq 1 ] || { echo "expected one @strapi/core, found:"; echo "$cores"; exit 1; }; \
    have="$(node -p "require('@strapi/core/package.json').version")"; \
    [ "$have" = "${STRAPI_VERSION}" ] || { echo "@strapi/core is $have, project is ${STRAPI_VERSION}"; exit 1; }; \
    grep -q ADHAR_BUNDLED_FEATURES node_modules/@strapi/core/dist/ee/index.js \
      || { echo "@strapi/core has no ADHAR_BUNDLED_FEATURES — not the fork's build"; exit 1; }

# The platform-managed files: public origin, Keycloak admin login and the SSO
# auto-register defaults. Secrets generated by the scaffold must never be baked
# into a shared image, so its .env goes.
COPY app/ ./
RUN rm -f .env

# Built with no PUBLIC_URL, so the admin bundle talks to its own origin and the
# same image serves any platform domain.
RUN npm run build

# The persistent paths become links into the volume. Made after the build so
# nothing above sees a dangling link.
RUN set -eu; \
    for d in src/api src/components src/extensions public/uploads; do \
      rm -rf "$d"; ln -s "/srv/app/$d" "$d"; \
    done

FROM ${NODE_IMAGE}

ARG STRAPI_VERSION
LABEL org.opencontainers.image.title="strapi" \
      org.opencontainers.image.description="Strapi ${STRAPI_VERSION} for the Adhar platform: prebuilt admin, Keycloak admin SSO" \
      org.opencontainers.image.licenses="MIT AND LicenseRef-Strapi-EE" \
      io.adhar.strapi.version="${STRAPI_VERSION}"

# tini reaps and forwards signals: `strapi develop` runs a cluster primary and
# a worker, and PID 1 must pass SIGTERM through for a clean shutdown.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development \
    HOST=0.0.0.0 \
    PORT=1337 \
    STRAPI_TELEMETRY_DISABLED=true \
    STRAPI_ADHAR_MODE=develop

COPY --from=build --chown=node:node /opt/app /opt/app
COPY --chmod=0755 entrypoint.sh /usr/local/bin/adhar-strapi
# Owned by the runtime user, so a fresh Docker volume (seeded from this
# directory) is writable. On Kubernetes, the pod's fsGroup does the same.
RUN install -d -o node -g node /srv

USER node
WORKDIR /opt/app
EXPOSE 1337
VOLUME ["/srv"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/adhar-strapi"]
